{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "docs:import-manifest": "ts-node --project tsconfig.json src/scripts/import-document-manifest.ts",
    "docs:ingest-content": "ts-node --project tsconfig.json src/scripts/ingest-document-content.ts",
    "docs:build-chunks": "ts-node --project tsconfig.json src/scripts/build-document-chunks.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.0.13",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.13",
    "@nestjs/platform-express": "11.0.13",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.5",
    "@nestjs/schematics": "11.0.2",
    "@nestjs/testing": "11.0.13",
    "@prisma/client": "^6.5.0",
    "@types/express": "5.0.0",
    "@types/node": "22.13.10",
    "eslint": "9.21.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-prettier": "5.2.3",
    "prettier": "3.5.3",
    "prisma": "^6.5.0",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "typescript": "5.8.2"
  }
}
